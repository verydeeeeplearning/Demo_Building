      { "fromRole": "power-rail", "toNet": "positive-rail", "signal": "power" },
      { "fromRole": "power-source.ground", "toNet": "ground-rail", "signal": "ground" },
      { "fromRole": "ground-rail", "toNet": "ground-rail", "signal": "ground" }
    ],
    "validationRules": [
