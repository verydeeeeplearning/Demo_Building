[
  {
    "id": "controller-i2c-sensor-display",
    "label": "Controller I2C protocol sensor readout on I2C display",
    "description": "A controller powers a low-voltage I2C sensor and an I2C text display, shares SDA/SCL, and shows a qualitative classroom readout.",
    "requiredRoles": [
      "controller",
      "power-source",
      "ground-return",
      "i2c-data",
      "i2c-clock",
      "protocol-sensor",
      "i2c-module"
    ],
    "nets": [
      { "id": "vcc", "kind": "power" },
      { "id": "ground", "kind": "ground" },
      { "id": "sda", "kind": "signal" },
      { "id": "scl", "kind": "signal" }
    ],
    "connections": [
      { "fromRole": "controller.power", "toNet": "vcc", "signal": "power" },
      { "fromRole": "protocol-sensor.power", "toNet": "vcc", "signal": "power" },
      { "fromRole": "i2c-module.power", "toNet": "vcc", "signal": "power" },
      { "fromRole": "controller.ground", "toNet": "ground", "signal": "ground" },
      { "fromRole": "protocol-sensor.ground", "toNet": "ground", "signal": "ground" },
      { "fromRole": "i2c-module.ground", "toNet": "ground", "signal": "ground" },
      { "fromRole": "controller.i2c-data", "toNet": "sda", "signal": "i2c-data" },
      { "fromRole": "protocol-sensor.i2c-data", "toNet": "sda", "signal": "i2c-data" },
      { "fromRole": "i2c-module.i2c-data", "toNet": "sda", "signal": "i2c-data" },
      { "fromRole": "controller.i2c-clock", "toNet": "scl", "signal": "i2c-clock" },
      { "fromRole": "protocol-sensor.i2c-clock", "toNet": "scl", "signal": "i2c-clock" },
      { "fromRole": "i2c-module.i2c-clock", "toNet": "scl", "signal": "i2c-clock" }
    ],
    "validationRules": [
      "i2c-protocol-sensor-pins",
      "i2c-pin-role-match",
      "common-ground",
      "power-rail-valid",
      "qualitative-sensor-readout-only"
    ],
    "simulationPrimitiveHints": [
      "display_sensor_value",
      "display_static_text",
      "current_flow_animation"
    ]
  },
