      { "fromRole": "controller.digital-output", "toNet": "logic-clock", "signal": "gpio" },
      { "fromRole": "logic-interface.clock", "toNet": "logic-clock", "signal": "gpio" },
      { "fromRole": "controller.digital-output", "toNet": "logic-latch-enable", "signal": "gpio" },
      { "fromRole": "logic-interface.enable", "toNet": "logic-latch-enable", "signal": "gpio" },
      { "fromRole": "controller.i2c-data", "toNet": "sda", "signal": "i2c-data" },
      { "fromRole": "i2c-module.i2c-data", "toNet": "sda", "signal": "i2c-data" },
      { "fromRole": "controller.i2c-clock", "toNet": "scl", "signal": "i2c-clock" },
