    "description": "A controller powers a logic interface IC, drives the required GPIO control pins, and shows qualitative interface state on an I2C display without inferring hidden output loads.",
    "requiredRoles": ["controller", "power-source", "ground-return", "data", "clock", "enable", "logic-interface", "i2c-data", "i2c-clock", "i2c-module"],
    "nets": [
      { "id": "vcc", "kind": "power" },
      { "id": "ground", "kind": "ground" },
      { "id": "logic-data", "kind": "signal" },
      { "id": "logic-clock", "kind": "signal" },
      { "id": "logic-latch-enable", "kind": "signal" },
      { "id": "sda", "kind": "signal" },
      { "id": "scl", "kind": "signal" }
    ],
    "connections": [
      { "fromRole": "controller.power", "toNet": "vcc", "signal": "power" },
      { "fromRole": "logic-interface.power", "toNet": "vcc", "signal": "power" },
