      {
        "id": "ground",
        "kind": "ground"
      }
    ],
    "connections": [
      {
        "fromRole": "controller.digital-output",
        "toNet": "segment-drive",
        "signal": "gpio"
      },
      {
        "fromRole": "series-current-limit.input",
        "toNet": "segment-drive",
        "signal": "gpio"
      },
      {
        "fromRole": "series-current-limit.output",
        "toNet": "segment-current-limit",
        "signal": "gpio"
      },
      {
        "fromRole": "bare-seven-segment-display.segment-anode",
        "toNet": "segment-current-limit",
        "signal": "gpio"
      },
      {
        "fromRole": "bare-seven-segment-display.ground",
        "toNet": "ground",
        "signal": "ground"
      },
      {
        "fromRole": "controller.ground",
        "toNet": "ground",
        "signal": "ground"
      }
    ],
    "validationRules": [
      "common-ground",
      "bare-seven-segment-common-ground",
      "bare-seven-segment-segment-resistor",
      "series-current-limit",
      "qualitative-sensor-readout-only"
    ],
    "simulationPrimitiveHints": [
      "bare_seven_segment_display_state",
      "current_flow_animation"
    ]
