[
  {
    "id": "controller-i2c-module",
    "label": "Controller to I2C module",
    "description": "A controller powers a low-voltage I2C module and connects SDA/SCL signal lines with a shared ground.",
    "requiredRoles": ["controller", "power-source", "ground-return", "i2c-data", "i2c-clock", "i2c-module"],
    "nets": [
      { "id": "vcc", "kind": "power" },
      { "id": "ground", "kind": "ground" },
      { "id": "sda", "kind": "signal" },
      { "id": "scl", "kind": "signal" }
    ],
    "connections": [
      { "fromRole": "controller.power", "toNet": "vcc", "signal": "power" },
      { "fromRole": "i2c-module.power", "toNet": "vcc", "signal": "power" },
      { "fromRole": "controller.ground", "toNet": "ground", "signal": "ground" },
      { "fromRole": "i2c-module.ground", "toNet": "ground", "signal": "ground" },
      { "fromRole": "controller.i2c-data", "toNet": "sda", "signal": "i2c-data" },
      { "fromRole": "i2c-module.i2c-data", "toNet": "sda", "signal": "i2c-data" },
      { "fromRole": "controller.i2c-clock", "toNet": "scl", "signal": "i2c-clock" },
      { "fromRole": "i2c-module.i2c-clock", "toNet": "scl", "signal": "i2c-clock" }
    ],
    "validationRules": ["common-ground", "i2c-pin-role-match", "power-rail-valid"],
    "simulationPrimitiveHints": ["display_static_text", "current_flow_animation"]
  },
  {
    "id": "controller-digital-output-series-load",
    "label": "Controller digital output through series current limit",
    "description": "A controller GPIO drives a DC load through a required current-limiting passive before returning to ground.",
    "requiredRoles": ["controller", "digital-output", "series-current-limit", "dc-load", "ground-return"],
    "nets": [
      { "id": "controller-output-net", "kind": "signal" },
      { "id": "load-input-net", "kind": "signal" },
      { "id": "ground", "kind": "ground" }
    ],
    "connections": [
      { "fromRole": "controller.digital-output", "toNet": "controller-output-net", "signal": "gpio" },
      { "fromRole": "series-current-limit.input", "toNet": "controller-output-net", "signal": "gpio" },
      { "fromRole": "series-current-limit.output", "toNet": "load-input-net", "signal": "gpio" },
      { "fromRole": "dc-load.input", "toNet": "load-input-net", "signal": "gpio" },
      { "fromRole": "dc-load.ground-return", "toNet": "ground", "signal": "ground" },
      { "fromRole": "controller.ground", "toNet": "ground", "signal": "ground" }
    ],
    "validationRules": ["series-current-limit", "closed-current-path", "led-polarity"],
    "simulationPrimitiveHints": ["digital_on_off", "blink_timer", "current_flow_animation"]
  },
