    "uiControls": [
      { "id": "digital_state", "type": "toggle", "label": "Output HIGH", "affects": ["digital-signal", "load-state"] }
    ],
    "animationCues": ["off state has no load animation", "on state animates along validated current path"],
    "renderOverlays": ["pin-state-badge", "current-flow-dots"],
    "limitations": ["Does not solve switching transients or semiconductor curves."]
  },
