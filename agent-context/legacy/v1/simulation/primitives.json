  {
    "id": "digital_on_off",
    "inputs": ["digital"],
    "outputs": ["digital"],
    "requiresElectricalAnalysis": true,
    "explanationTemplate": "The output switches between HIGH and LOW.",
    "requiredNetRoles": ["power", "ground", "digital-signal"],
    "requiredComponentCapabilities": ["controller-source", "digital-output-load"],
    "validationRules": ["common-ground", "closed-current-path", "output-pin-exists"],
    "currentPathRecipe": {
      "type": "closed-dc-load-path",
      "requiredNetRoles": ["power", "load", "ground"],
      "description": "Show current only after the validator proves a closed path from the supply, through the load, and back to ground.",
      "pathTemplate": {
        "id": "led-forward-current",
        "kind": "load-current",
        "label": "LED forward current",
        "sourceEndpoint": "controller-signal",
        "returnEndpoint": "controller-ground",
        "through": ["required-passives", "target"],
        "fallbackControllerPin": "D9",
        "animation": { "color": "#ff4d3d", "speed": 0.82 }
      }
    },
    "expectedStateRecipe": {
      "type": "digital-state",
      "states": ["LOW", "HIGH"],
      "description": "Map controller LOW/HIGH output to the visible off/on state of the connected load."
