{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h-eduware.local/schemas/capability-graph.schema.json",
  "title": "H-eduware Capability Graph",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "supportLevel", "positivePhrases", "requiredEvidence", "minimumScore", "studentPhrases"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "supportLevel": {
        "type": "string",
        "enum": ["supported", "partial", "planned", "unsupported"]
      },
      "positivePhrases": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "minItems": 1
      },
      "requiredEvidence": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "minItems": 1
      },
      "negativeEvidence": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "minimumScore": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 1
      },
      "studentPhrases": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "minItems": 1
      },
      "inputModalities": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "outputModalities": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "requiredRoles": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "requiredParts": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "optionalParts": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "protocols": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "simulationPrimitives": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "renderFootprints": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "validationRules": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "commonMistakes": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "safeAlternatives": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "unsupportedReason": { "type": "string" }
    }
  }
}
