{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h-eduware.local/schemas/hardware-support-bundle.schema.json",
  "title": "HardwareSupportBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundleId",
    "capabilityId",
    "supportLevel",
    "requiredArtifacts",
    "sourceClaimIds",
    "canonicalFiles",
    "browserEvidenceIds"
  ],
  "properties": {
    "bundleId": { "type": "string", "minLength": 1 },
    "capabilityId": { "type": "string", "minLength": 1 },
    "supportLevel": {
      "type": "string",
      "enum": ["supported", "partial", "planned", "unsupported"]
    },
    "requiredParts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "requiredArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "source-claims",
          "capability-graph-entry",
          "part-capability",
          "pin-aliases",
          "validation-rule",
          "simulation-primitive",
          "render-footprint",
          "eval-supported-prompt",
          "eval-unsupported-counterexample",
          "browser-visible-verification"
        ]
      }
    },
    "sourceClaimIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "canonicalFiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "browserEvidenceIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
