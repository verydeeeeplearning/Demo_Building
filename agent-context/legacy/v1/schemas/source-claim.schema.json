{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h-eduware.local/schemas/source-claim.schema.json",
  "title": "SourceClaim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claimId",
    "subjectId",
    "subjectType",
    "claimType",
    "fieldPath",
    "value",
    "sourceTier",
    "sourceTitle",
    "sourceUrl",
    "sourceDateChecked",
    "evidenceQuote",
    "confidence"
  ],
  "properties": {
    "claimId": { "type": "string", "minLength": 1 },
    "subjectId": { "type": "string", "minLength": 1 },
    "subjectType": {
      "type": "string",
      "enum": ["part", "pin", "board", "footprint", "simulation", "validation-rule", "topology"]
    },
    "claimType": {
      "type": "string",
      "enum": [
        "pin-map",
        "electrical-limit",
        "protocol-support",
        "physical-dimension",
        "breadboard-continuity",
        "simulation-model",
        "validation-rule",
        "pedagogy"
      ]
    },
    "fieldPath": { "type": "string", "minLength": 1 },
    "value": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "array", "items": { "type": "string" } },
        { "type": "object" }
      ]
    },
    "units": { "type": "string" },
    "sourceTier": {
      "type": "string",
      "enum": [
        "manufacturer-official",
        "vendor-technical-guide",
        "eda-library",
        "educational-reference",
        "h-eduware-derived"
      ]
    },
    "sourceTitle": { "type": "string", "minLength": 1 },
    "sourceUrl": { "type": "string", "format": "uri" },
    "sourceDateChecked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "evidenceQuote": { "type": "string", "minLength": 1, "maxLength": 240 },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "notes": { "type": "string" }
  }
}
