{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h-eduware.local/schemas/validation-result.schema.json",
  "title": "ValidationResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "errors", "warnings", "sourceVersion"],
  "properties": {
    "version": { "const": "2026-05-31" },
    "status": { "enum": ["valid", "invalid", "valid_with_warnings", "unsupported"] },
    "errors": { "type": "array", "items": { "type": "object" } },
    "warnings": { "type": "array", "items": { "type": "object" } },
    "electricalAnalysis": { "type": "object" },
    "simulationSupport": { "type": "object" },
    "renderSupport": { "type": "object" },
    "sourceVersion": { "type": "string" }
  }
}
