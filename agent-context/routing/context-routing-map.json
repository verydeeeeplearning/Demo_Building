{
  "version": "2026-05-31",
  "maxPromptCharsByBudget": {
    "minimal": 7000,
    "summary": 14000,
    "data-only": 18000,
    "full": 38000
  },
  "heavySourceIds": [
    "registry:part-capabilities",
    "simulation:primitives",
    "rendering:render-footprints"
  ],
  "routes": [
    {
      "routeId": "ambiguous-minimal",
      "priority": 10,
      "budget": "minimal",
      "when": {
        "ambiguity": true
      },
      "load": {
        "memory": ["memory:agent-rules"],
        "policy": ["policy:safety", "policy:clarification", "policy:truthfulness"],
        "reference": ["reference:protocol-rules"]
      },
      "reason": "No concrete supported input/output hardware was identified, so only clarification and safety context should be loaded."
    },
    {
      "routeId": "unsupported-safety",
      "priority": 20,
      "budget": "minimal",
      "when": {
        "unsafe": true,
        "supportLevels": ["unsupported"]
      },
      "load": {
        "memory": ["memory:agent-rules"],
        "policy": ["policy:safety", "policy:unsupported", "policy:truthfulness"],
        "data": ["data:capability-graph"],
        "reference": ["reference:electrical-limits", "reference:validation-rules"]
      },
      "reason": "Unsafe or unsupported requests need policy, capability, and validation rationale, not render or simulation catalogs."
    },
    {
      "routeId": "planned-capability-gap",
      "priority": 30,
      "budget": "summary",
      "when": {
        "supportLevels": ["planned", "partial"]
      },
      "load": {
        "memory": ["memory:agent-rules"],
        "policy": ["policy:safety", "policy:unsupported", "policy:truthfulness"],
        "data": ["data:capability-graph"],
        "registry": ["registry:part-capabilities"],
        "reference": ["reference:validation-rules", "reference:electrical-limits"]
      },
      "reason": "Planned or partial capabilities need exact gap evidence and safe alternatives without pretending render or simulation support exists."
    },
    {
      "routeId": "display-i2c-output",
      "priority": 40,
      "budget": "full",
      "when": {
        "capabilityIds": ["display-text-output"],
        "modalities": ["display"]
      },
      "load": {
        "memory": ["memory:agent-rules"],
        "policy": ["policy:safety", "policy:truthfulness"],
        "data": ["data:capability-graph", "data:topology-templates"],
        "registry": ["registry:part-capabilities"],
        "reference": ["reference:board-topology", "reference:protocol-rules", "reference:validation-rules", "reference:simulation-recipes", "reference:rendering-footprints"],
        "simulation": ["simulation:primitives"],
        "rendering": ["rendering:render-footprints"]
      },
      "reason": "I2C display output requires bus pin rules, supported OLED registry facts, render anchors, and current/signal simulation primitives."
    },
    {
      "routeId": "digital-output-series-load",
      "priority": 50,
      "budget": "full",
      "when": {
        "capabilityIds": ["digital-light-output"],
        "modalities": ["light"]
      },
      "load": {
        "memory": ["memory:agent-rules"],
        "policy": ["policy:safety", "policy:truthfulness"],
        "data": ["data:capability-graph", "data:topology-templates"],
        "registry": ["registry:part-capabilities"],
        "reference": ["reference:board-topology", "reference:protocol-rules", "reference:validation-rules", "reference:simulation-recipes", "reference:rendering-footprints"],
        "simulation": ["simulation:primitives"],
        "rendering": ["rendering:render-footprints"]
      },
      "reason": "A digital LED load requires current limiting, closed-path validation, render anchors, and load-current animation context."
    },
    {
      "routeId": "button-controlled-digital-load",
      "priority": 45,
      "budget": "full",
      "when": {
        "capabilityIds": ["button-controlled-light-output"],
        "modalities": ["button", "light"]
      },
      "load": {
        "memory": ["memory:agent-rules"],
        "policy": ["policy:safety", "policy:truthfulness"],
        "data": ["data:capability-graph", "data:topology-templates", "data:pin-aliases"],
        "registry": ["registry:part-capabilities"],
        "reference": ["reference:board-topology", "reference:protocol-rules", "reference:validation-rules", "reference:simulation-recipes", "reference:rendering-footprints"],
        "simulation": ["simulation:primitives"],
        "rendering": ["rendering:render-footprints"]
      },
      "reason": "Button-controlled LED output needs input pullup/pulldown validation, LED current limiting, render anchors, and interactive state simulation."
    },
    {
      "routeId": "sound-output",
      "priority": 70,
      "budget": "full",
      "when": {
        "capabilityIds": ["sound-alert-output"],
        "modalities": ["sound"]
      },
      "load": {
        "memory": ["memory:agent-rules"],
        "policy": ["policy:safety", "policy:truthfulness"],
        "data": ["data:capability-graph", "data:topology-templates"],
        "registry": ["registry:part-capabilities"],
        "reference": ["reference:board-topology", "reference:protocol-rules", "reference:validation-rules", "reference:simulation-recipes", "reference:rendering-footprints"],
        "simulation": ["simulation:primitives"],
        "rendering": ["rendering:render-footprints"]
      },
      "reason": "Sound output requires buzzer polarity/current context, GPIO or PWM protocol rules, render anchors, and pulse simulation primitives."
    },
    {
      "routeId": "servo-pwm-output",
      "priority": 80,
      "budget": "full",
      "when": {
        "capabilityIds": ["servo-motion-output"],
        "modalities": ["motion"]
      },
      "load": {
        "memory": ["memory:agent-rules"],
        "policy": ["policy:safety", "policy:truthfulness"],
        "data": ["data:capability-graph", "data:topology-templates"],
        "registry": ["registry:part-capabilities"],
        "reference": ["reference:board-topology", "reference:protocol-rules", "reference:validation-rules", "reference:simulation-recipes", "reference:rendering-footprints", "reference:electrical-limits"],
        "simulation": ["simulation:primitives"],
        "rendering": ["rendering:render-footprints"]
      },
      "reason": "Servo output needs PWM, supply-current warning, common-ground validation, render anchors, and separate signal/supply simulation primitives."
    },
    {
      "routeId": "supported-hardware-general",
      "priority": 100,
      "budget": "full",
      "when": {
        "supportLevels": ["supported"]
      },
      "load": {
        "memory": ["memory:agent-rules"],
        "policy": ["policy:safety", "policy:truthfulness"],
        "data": ["data:capability-graph", "data:topology-templates"],
        "registry": ["registry:part-capabilities"],
        "reference": ["reference:board-topology", "reference:protocol-rules", "reference:validation-rules", "reference:simulation-recipes", "reference:rendering-footprints"],
        "simulation": ["simulation:primitives"],
        "rendering": ["rendering:render-footprints"]
      },
      "reason": "Supported hardware fallback loads the complete bounded synthesis, validation, rendering, and simulation bundle."
    }
  ]
}
