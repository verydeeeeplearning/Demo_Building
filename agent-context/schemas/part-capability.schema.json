{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h-eduware.local/schemas/part-capability.schema.json",
  "title": "PartCapability",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "label", "aliases", "pins", "electrical", "protocols", "renderFootprint", "simulationModel"],
  "properties": {
    "id": { "type": "string" },
    "kind": { "type": "string" },
    "label": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "pins": { "type": "array", "items": { "type": "object" } },
    "electrical": { "type": "object" },
    "protocols": { "type": "array", "items": { "type": "string" } },
    "requiredPassives": { "type": "array", "items": { "type": "object" } },
    "renderFootprint": { "type": "object" },
    "simulationModel": { "type": "object" },
    "supportLevel": { "type": "string", "enum": ["supported", "partial", "planned", "unsupported"] },
    "supportTier": { "type": "string", "enum": ["simulation-ready", "context-known", "pin-known", "visual-only", "catalog-only", "unsafe-blocked"] },
    "family": { "type": "string" },
    "riskLevel": { "type": "string", "enum": ["low-voltage", "power-warning", "high-current", "mains-unsafe", "unknown"] },
    "visualPartIds": { "type": "array", "items": { "type": "string" } },
    "compatibleTopologies": { "type": "array", "items": { "type": "string" } },
    "requiredExternalParts": { "type": "array", "items": { "type": "string" } },
    "forbiddenTopologies": { "type": "array", "items": { "type": "string" } },
    "sourceClaimIds": { "type": "array", "items": { "type": "string" } },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "compatibleSimulationPrimitives": { "type": "array", "items": { "type": "string" } },
    "commonMistakes": { "type": "array", "items": { "type": "string" } },
    "safeSubstitutes": { "type": "array", "items": { "type": "string" } }
  }
}
