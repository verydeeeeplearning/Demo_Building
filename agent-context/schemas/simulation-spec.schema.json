{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h-eduware.local/schemas/simulation-spec.schema.json",
  "title": "SimulationSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "primitives", "currentPaths", "limitations"],
  "properties": {
    "version": { "const": "2026-05-31" },
    "status": { "enum": ["valid", "invalid", "unsupported"] },
    "primitives": { "type": "array", "items": { "type": "string" } },
    "currentPaths": { "type": "array", "items": { "type": "object" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
