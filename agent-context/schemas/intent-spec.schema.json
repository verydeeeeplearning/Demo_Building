{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h-eduware.local/schemas/intent-spec.schema.json",
  "title": "IntentSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "originalPrompt", "goalSummary", "inputs", "outputs", "constraints", "safetyFlags", "confidence"],
  "properties": {
    "version": { "const": "2026-05-31" },
    "originalPrompt": { "type": "string" },
    "learnerLevel": { "enum": ["elementary", "middle_high", "university", "unknown"] },
    "goalSummary": { "type": "string" },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "decisions": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "feedbackMode": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "missingInformation": { "type": "array", "items": { "type": "string" } },
    "safetyFlags": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
