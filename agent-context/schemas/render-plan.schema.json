{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h-eduware.local/schemas/render-plan.schema.json",
  "title": "RenderPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "parts", "connections", "floatingCards"],
  "properties": {
    "version": { "const": "2026-05-31" },
    "title": { "type": "string" },
    "runText": { "type": "string" },
    "parts": { "type": "array", "items": { "type": "object" } },
    "connections": { "type": "array", "items": { "type": "object" } },
    "floatingCards": { "type": "array", "items": { "type": "object" } },
    "layout": { "type": "object" }
  }
}
